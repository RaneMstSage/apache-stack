# SSH Router Configuration
Port 22
PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
ChallengeResponseAuthentication no
UsePAM no

# Host keys
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# Logging
SyslogFacility AUTH
LogLevel DEBUG3

# Connection settings
ClientAliveInterval 60
ClientAliveCountMax 3
MaxStartups 10:30:100

# SFTP (disabled for this router)
# Subsystem sftp /usr/lib/openssh/sftp-server

# Admin user routing to Windows
Match User ADMIN_USERNAME_PLACEHOLDER
    AuthorizedKeysFile /etc/ssh/keys/%u_authorized_keys
    ForceCommand /opt/scripts/windows_proxy.py
    AllowAgentForwarding yes
    AllowTcpForwarding yes
    X11Forwarding no