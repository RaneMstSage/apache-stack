# SSH Router Configuration
Port 22
PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
ChallengeResponseAuthentication no
UsePAM no

# Host keys
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# Logging
SyslogFacility AUTH
LogLevel VERBOSE

# Connection settings
ClientAliveInterval 60
ClientAliveCountMax 3
MaxStartups 10:30:100

# SFTP (disabled for this router)
# Subsystem sftp /usr/lib/openssh/sftp-server

# Admin user routing to Windows
Match User ADMIN_USERNAME_PLACEHOLDER
    AuthorizedKeysFile /etc/ssh/keys/ADMIN_USERNAME_PLACEHOLDER_authorized_keys
    ForceCommand /opt/scripts/windows_proxy.py
    AllowAgentForwarding yes
    AllowTcpForwarding yes
    X11Forwarding no

# Git user routing to Git repositories
Match User GIT_USERNAME_PLACEHOLDER
    AuthorizedKeysFile /etc/ssh/keys/GIT_USERNAME_PLACEHOLDER_authorized_keys
    ForceCommand /opt/scripts/git_proxy.py
    AllowAgentForwarding no
    AllowTcpForwarding no
    X11Forwarding no
    PermitTTY no

# SVN user - route to SVN repositories
Match User SVN_USERNAME_PLACEHOLDER
    AuthorizedKeysFile /etc/ssh/keys/SVN_USERNAME_PLACEHOLDER_authorized_keys
    ForceCommand /opt/scripts/svn_proxy.py
    AllowAgentForwarding no
    AllowTcpForwarding no
    X11Forwarding no
    PermitTTY no

# Enable SSH key fingerprint exposure
ExposeAuthInfo yes
PermitUserEnvironment yes