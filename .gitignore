# Ignore Apache configuration and web files stored outside container
data/

# Ignore any temporary build files
*.log
*.tmp

# Ignore Docker-related artifacts
*.pid

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore editor-specific files
.vscode/
.idea/
*.swp

# Environment variables and secrets
.env
*.env
env/
secrets/
*_password.txt
*_secret.txt

# Docker Compose overrides that might contain credentials
docker-compose.override.yml

volumes/redmine/plugins/*
volumes/redmine/plugins/**

volumes/redmine/themes/*
volumes/redmine/themes/**