# ==============================================================================
# Docker Volume Configuration
# ==============================================================================
# Base path where all your Docker volumes will be stored
# Example: ~/docker-volumes/apache-stack or /opt/docker/apache-stack
DOCKER_VOLUMES_BASE=

# Repository paths - using the same base path but outside Docker volumes
WSL_SVN_REPOS_PATH=~/docker-volumes/repos/svn_repos
WSL_GIT_REPOS_PATH=~/docker-volumes/repos/git_repos
WSL_GIT_LFS_PATH=~/docker-volumes/repos/git_lfs

# ==============================================================================
# Port Configuration
# ==============================================================================
# These ports are what you'll use to access services from your host machine
# Make sure these ports are not already in use on your system

# Nginx reverse proxy ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Apache web server ports
APACHE_HTTP_PORT=8080
APACHE_HTTPS_PORT=8443

# Redmine project management tool
REDMINE_PORT=3000

# MySQL database server
MYSQL_PORT=3306

# LDAP directory service ports
LDAP_PORT=389
LDAPS_PORT=636
LDAP_HOST=openldap

WINDOWS_SSH_HOST=
WINDOWS_SSH_PORT=2221

# SSH Router (takes over port 2222 from Windows host)
# Note: Windows SSH should be moved to port 2221

# ==============================================================================
# SSH Router Configuration
# ==============================================================================
# SSH Router provides user-based routing similar to nginx for HTTP
# Routes different SSH users to different backend services

# Admin username for Windows SSH routing
# This is the username you'll use when connecting: ssh admin@server -p 2222
# It's also the username SSH router will use when connecting to Windows
# Example: sage, admin, your_actual_username
ADMIN_USERNAME=

# ==============================================================================
# Git SSH Configuration
# ==============================================================================
# Username for Git SSH access (default: git)
# This is what users will use: git@code.mstsage.com:2222
# Example: git, gituser, vcs
GIT_USERNAME=git

# ==============================================================================
# SVN SSH Configuration
# ==============================================================================
# Username for SVN SSH access (default: svn)
# This is what users will use: svn@code.mstsage.com:2222
# Example: svn, svnuser
SVN_USERNAME=svn

# ==============================================================================
# LDAP Configuration
# ==============================================================================
# Your organization's LDAP settings

# Organization name as it will appear in LDAP
# Example: "My Company Name" or "Development Team"
LDAP_ORGANISATION=

# Your domain name for LDAP
# Example: mycompany.com or dev.local
LDAP_DOMAIN=

# Strong password for LDAP admin account
# This will be used to manage your LDAP directory
LDAP_ADMIN_PASSWORD=

# Base DN derived from your domain (mstsage.com)
LDAP_BASE_DN=dc=mstsage,dc=com

# Admin DN for binding (standard LDAP admin structure)
LDAP_BIND_DN=cn=admin,dc=mstsage,dc=com

# ==============================================================================
# MySQL Database Configuration
# ==============================================================================
# MySQL root password - make this strong and unique
MYSQL_ROOT_PASSWORD=

# Initial database to create
# Example: app_database or development_db
MYSQL_DATABASE=

# Database user for your applications
# Example: app_user or dbadmin
MYSQL_USER=

# Password for the database user
MYSQL_PASSWORD=

# ==============================================================================
# Redmine Configuration
# ==============================================================================
# Database name for Redmine
# Example: redmine_production
REDMINE_DB_DATABASE=

# Database user for Redmine
# Example: redmine_user
REDMINE_DB_USERNAME=

# Database password for Redmine user
REDMINE_DB_PASSWORD=

# Secret key for Redmine sessions and security
# Generate with: openssl rand -hex 64
REDMINE_SECRET_KEY_BASE=

# ==============================================================================
# Additional Notes
# ==============================================================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit the .env file to version control
# 3. Keep your .env file secure - it contains sensitive information
# 4. Different environments (dev, staging, prod) should have different values
# 5. Use strong, unique passwords for all services
# 6. SSH Router requires Windows SSH to be moved from port 2222 to port 2221
# ==============================================================================